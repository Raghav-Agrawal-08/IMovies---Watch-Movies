# IMovies Backend Environment Variables

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Leave blank to run with built-in embedded in-memory MongoDB database automatically
MONGODB_URI=

# JWT Secret for session authentication tokens
JWT_SECRET=imovies_super_secret_jwt_key_2026_cinematic

# Razorpay Payment Gateway Credentials (Optional: Leave empty for demo mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# PhonePe Merchant Details
PHONEPE_MERCHANT_VPA=imovies.ticket@phonepe
PHONEPE_MERCHANT_NAME=IMOVIES ENTERTAINMENT PVT LTD
