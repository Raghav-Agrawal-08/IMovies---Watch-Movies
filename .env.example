# ==============================================================================
# IMOVIES - ENVIRONMENT CONFIGURATION (VERCEL & LOCAL)
# ==============================================================================

# 1. MongoDB Database Connection (MANDATORY FOR VERCEL DEPLOYMENT)
# Create a 100% free MongoDB cluster at https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<databaseName>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yourdomain.mongodb.net/imovies?retryWrites=true&w=majority

# 2. JWT Authentication Secret
# Any secure random string (minimum 32 characters recommended)
JWT_SECRET=imovies_super_secure_jwt_secret_key_2026_xyz987

# 3. Port (Used for local running; ignored on Vercel serverless)
PORT=5000

# 4. Atlas Database Seeding Secret
# Protects the /api/seed endpoint in production from unauthorized triggers
SEED_SECRET=seed_imovies_2026

# 5. Razorpay Payment Gateway (Optional / Sandbox)
# Leave empty or set to test keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# 6. PhonePe Merchant Details (Displayed in Checkout)
PHONEPE_MERCHANT_NAME=Raghav Agrawal
PHONEPE_VPA=raghav.agrawal@phonepe
