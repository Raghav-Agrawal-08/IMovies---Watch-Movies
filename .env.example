# ==========================================
# IMOVIES FULL-STACK CONFIGURATION EXAMPLE
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Leave blank to automatically use the built-in In-Memory MongoDB database for immediate testing
MONGODB_URI=

# JWT Authentication Secret Key
JWT_SECRET=imovies_super_secret_jwt_key_2026_cinematic

# Razorpay Gateway API Keys (Optional - only required if enabling live Razorpay payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# PhonePe Merchant Settings
PHONEPE_MERCHANT_VPA=imovies.ticket@phonepe
PHONEPE_MERCHANT_NAME=IMOVIES ENTERTAINMENT PVT LTD
